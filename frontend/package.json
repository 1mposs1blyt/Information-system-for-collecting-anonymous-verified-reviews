{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start:docker": "electron . --no-sandbox --disable-gpu",
    "dev:docker": "npx serve dist",
    "dev": "vite",
    "dev:electron": "VITE_USE_ELECTRON=true vite",
    "build:web": "tsc && vite build",
    "build:electron": "VITE_USE_ELECTRON=true tsc && vite build && electron-builder",
    "build": "npm run build:electron",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "watch:css": "tailwindcss -i ./src/styles/styles.css -o ./src/styles/style.css --watch",
    "tailwind:watch": "tailwindcss -i ./src/styles/styles.css -o ./src/styles/style.css --watch",
    "electron:start": "vite --host",
    "start": "concurrently \"npm run tailwind:watch\" \"npm run electron:start\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/recharts": "^1.8.29",
    "js-cookie": "^3.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^19.2.7",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^5.0.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.3",
    "prettier-eslint": "^16.1.2",
    "typescript": "^4.4.4",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
